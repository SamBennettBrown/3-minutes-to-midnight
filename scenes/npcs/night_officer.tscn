barks = [{
"dur": 3.0,
"t": 62.0,
"text": "Evening, Rosa. Long night, huh?"
}, {
"dur": 4.0,
"t": 90.0,
"text": "Ugh - I lost another dollar to that damn vending machine. Third time this week."
}]
dialogue = [{
"speaker": "NIGHT OFFICER",
"text": "Night shift. You're the day guy who won't go home, huh? It's all yours, detective."
}, {
"speaker": "NIGHT OFFICER",
"text": "Looking for the evidence clerk? Ha - he always skips out a little early. Clocks his card, drops it at the desk, and he's a ghost before midnight."
}]
