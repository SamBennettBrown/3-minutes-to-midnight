dialogue_variants = [{
"lines": [{
"speaker": "PRISONER",
"text": "Three minutes to midnight and nobody in this building can sit still. You feel it too, right, detective?"
}]
}, {
"lines": [{
"speaker": "PRISONER",
"text": "Your witness? He was in the cell over not ten minutes ago. He's down in interrogation now - through the bullpen, off HALL 1."
}, {
"speaker": "PRISONER",
"text": "He seemed really nervous, helpless even. He didn't seem to have any confidence in the police's ability to protect him"
}, {
"speaker": "DETECTIVE",
"text": "Interrogation, off Hall 1. Worth a look."
}],
"once": true,
"sets_flag": "inmate_tip"
}, {
"after": 158.0,
"lines": [{
"speaker": "PRISONER",
"text": "They put your guy in the cell over. ...Anyway. The pipes in this place knock four times before the heat comes on. Three years, you notice things."
}]
}]
