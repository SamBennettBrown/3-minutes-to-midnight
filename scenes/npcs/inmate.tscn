dialogue_variants = [{
"lines": [{
"speaker": "PRISONER",
"text": "Quiet night. Well - except the shot. There's always the shot."
}]
}, {
"lines": [{
"speaker": "PRISONER",
"text": "Your witness? They marched him right past me not ten minutes ago. He's down in interrogation now - the whole night shift's crammed in around him."
}, {
"speaker": "PRISONER",
"text": "Word inside is somebody wanted him gone. Somebody CLOSE. He was safer in HERE, detective. Bars keep things out better than they keep things in."
}, {
"speaker": "DETECTIVE",
"text": "Interrogation. Somebody with a badge, a schedule, and three minutes. Let's go have a look."
}],
"once": true,
"sets_flag": "inmate_tip"
}]
