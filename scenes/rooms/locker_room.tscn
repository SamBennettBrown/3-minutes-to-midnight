[node name="SM_Prop_Weapon_Locker_05" parent="Props" unique_id=2062319173 instance=ExtResource("5_1k2jd")]
transform = Transform3D(1.1924881e-08, 0, -1, 0, 1, 0, 1, 0, 1.1924881e-08, 4.779654, 0.010403633, 2.7900233)
script = ExtResource("91_item")
dialogue = [{
"speaker": "LOCKER",
"text": "The evidence clerk's locker. Cleared out - empty hangers, one bent. He wasn't planning on coming back tonight."
}]
prompt_height = 1.6
examine_sound = "res://audio/sfx/door_close.mp3"

[node name="SM_Prop_Weapon_Locker_06" parent="Props" unique_id=1206367764 instance=ExtResource("5_1k2jd")]
transform = Transform3D(-4.371139e-08, 0, -1, 0, 1, 0, 1, 0, -4.371139e-08, 4.7876024, 0.010403633, -3.5)
script = ExtResource("93_keypad")
code = "0806"
sets_flag = "captains_locker_open"
unlocked_text = "I swing the locker off the wall again. The passage - right where he left it."
prompt_height = 1.6
reveal_dialogue = [{
"speaker": "DETECTIVE",
"text": "0806. Deputy Biscuit's birthday. The lock clicks. Alright, Captain - let's have that gun. End this whole thing right here."
}, {
"speaker": "DETECTIVE",
"text": "...Oh. That's not what I expected."
}, {
"speaker": "DETECTIVE",
"text": "The whole locker swings off the wall like a door - and behind it, A hidden chamber.."
}, {
"speaker": "DETECTIVE",
"text": "He doesn't keep the murder weapon here, but that doesn't make him innocent.. This is how he gets to the witness - right through the wall."
}]
reveal_flag = "captain_is_guilty"
opens_loop_flag = "passage_open_this_loop"
hide_when_flag = "passage_open_this_loop"

