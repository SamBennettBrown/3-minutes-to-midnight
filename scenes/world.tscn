paced = true
visible_mesh = "SM_Chr_Criminal_Female_01"
hair_path = "res://POLYGON_Police_Station_SourceFiles_v3/SourceFiles/FBX/SM_Chr_Attach_Hair_03.fbx"
dialogue_variants = [{
"lines": [{
"speaker": "PRISONER",
"text": "Quiet night. Well - except the shot. There's always the shot."
}]
}, {
"lines": [{
"speaker": "PRISONER",
"text": "That witness they marched past? Word inside was somebody wanted him gone. Somebody CLOSE. You want my professional opinion, detective?"
}, {
"speaker": "PRISONER",
"text": "He was safer in HERE. Bars keep things out better than they keep things in."
}, {
"speaker": "DETECTIVE",
"text": "Somebody close. Somebody with a badge, a schedule, and three minutes."
}],
"once": true,
"sets_flag": "inmate_tip"
}]

