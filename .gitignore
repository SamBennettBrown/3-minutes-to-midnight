/build/
/builds/
/export/
/exports/
*.exe
*.pck
*.zip
*.dmg
*.apk
*.aab
*.ipa
*.x86_64
*.x86
*.wasm

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
